{
  "rewrites": [
    {
      "source": "/p/:id",
      "destination": "/api/preview/:id"
    },
    {
      "source": "/loja/:uid",
      "destination": "/loja.html?uid=:uid"
    },
    {
      "source": "/vitrine",
      "destination": "/vitrine.html"
    },
    {
      "source": "/:slug",
      "destination": "/loja.html?slug=:slug"
    }
  ]
}
